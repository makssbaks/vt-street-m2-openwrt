'use strict';
import {number, hex, parse_cell, cells, signals, general, same_identity, modem_path, external, expose} from '../../package/vtcell/files/usr/share/vtcell/core.uc';
let c=parse_cell('cell type: lte, serving: yes, operator id: 25002, tac: 1234, ci: 1234502, physical ci: 17C, earfcn: 2850, rsrp: -82.000000, rsrq: -9.000000, timing advance: 0');
assert(c.band==7 && c.pci==380 && c.ci==19088642 && c.enb==74565 && c.sector==2);
assert(c.tac==4660 && c.ta===0 && c.rsrp==-82 && c.rsrq==-9);
assert(parse_cell('cell type: lte, serving: no, physical ci: AB, rsrp: -97, rsrq: -20').channel===null);
assert(parse_cell('cell type: lte, serving: no, physical ci: 503').pci===null); // hex 0x503 > 503
let nr=parse_cell('cell type: 5gnr, serving: yes, ci: 123456789, physical ci: 3EF, nrarfcn: 640000, rsrp: -99');
assert(nr.rat=='NR' && nr.enb===null && nr.sector===null && nr.ci==4886718345);
assert(hex('100',503)==256 && hex('invalid',503)===null);
assert(number('--',-200,0)===null && number('',-200,0)===null && number(null,-200,0)===null);
assert(signals({modem:{signal:{lte:{rssi:'-95.00',snr:'-3276.80'}}}}).lte.snr===null);
assert(signals({modem:{signal:{lte:{snr:'0'}}}}).lte.snr===0);
assert(cells({modem:{generic:{'cell-info':['cell type: lte, serving: no, physical ci: 38']}}})[0].pci==56);
assert(cells({modem:{generic:{'cell-info':'bad'}}})===null);
let g=general({modem:{generic:{device:'usb',sim:'sim',state:'connected',revision:'T99',ports:['cdc-wdm0 (mbim)']},'3gpp':{'operator-name':'Operator'}}});
assert(g.operator=='Operator' && !('imei' in g) && !('imsi' in g));
assert(same_identity(g,g) && !same_identity(g,{identity:['changed']}));
assert(modem_path({'modem-list':['/org/freedesktop/ModemManager1/Modem/7']})=='/org/freedesktop/ModemManager1/Modem/7');
assert(modem_path({'modem-list':['/Modem/0','/Modem/1']})===null);
let d={cid:c.ci,pci:c.pci,earfcn:c.channel};
assert(external({ca:'B7+B3',sinr:0,temp:41},d,5,6,c,true).snr===0);
assert(external({ca:'B7+B3'},d,5,9,c,true)===null);
assert(external({ca:'B7+B3'},d,46,46,c,true)===null);
assert(external({ca:'B7+B3'},d,1,1,c,false)===null);
assert(external({ca:'B7+B3'},{cid:c.ci,pci:1,earfcn:c.channel},1,1,c,true)===null);
assert(external({ca:'B7<script>'},d,1,1,c,true).ca===null);
assert(expose({boot:'old',monotonic_ms:1000},2000,'new').stale);
assert(expose({boot:'same',monotonic_ms:1000},37000,'same').stale);
assert(!expose({boot:'same',monotonic_ms:1000},2000,'same').stale);
assert(expose({boot:'same',monotonic_ms:1000,extra:{age_seconds:40}},10000,'same').extra===null);
print('VT_CELL_UCODE_TESTS_OK\n');
