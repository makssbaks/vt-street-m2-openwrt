     if(a<argc && !strcmp(argv[a],"-d")) { if(a+1>=argc){usage(argv[0]);return 64;} dev=argv[a+1]; a+=2; }
     if(a>=argc){usage(argv[0]);return 64;}
-    if(!strcmp(argv[a],"list") && a+1==argc) return list_sms(dev);
