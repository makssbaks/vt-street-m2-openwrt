{
  "luci-app-vtmodem": {
    "description": "Grant access to VT modem status, SMS and radio settings",
    "read": {
      "ubus": {
        "vtmodem": [
          "status",
          "traffic_status",
          "sms_list_start",
          "sms_job_status",
          "radio_status",
          "connection_status"
        ]
      }
    },
    "write": {
      "ubus": {
        "vtmodem": [
          "sms_send_start",
          "sms_delete_start",
          "radio_apply",
          "traffic_confirm_time",
          "connection_action"
        ]
      }
    }
  }
}
