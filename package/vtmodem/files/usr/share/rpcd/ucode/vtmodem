'use strict';

import { popen } from 'fs';
import { detect_modem, cached_status } from '/usr/share/vtmodem/telemetry-cache.uc';
import { sms_start, sms_job_status } from '/usr/share/vtmodem/sms-jobs.uc';
import { traffic_status, traffic_confirm_time } from '/usr/share/vtmodem/traffic.uc';

function shellquote(s) { return `'${replace(s ?? '', "'", "'\\''")}'`; }
function radio_call(m, args) {
	if (!m || m.type != 't99w175')
		return { ok: false, supported: false, changed: false, verified: false,
			error: 'Radio controls require a connected T99W175 modem' };
	let changing = args.action != 'status';
	if (changing && (args.confirm !== true || type(args.action) != 'string' ||
		index([ 'mode', 'bands', 'priority', 'lock', 'unlock' ], args.action) < 0 ||
		type(args.value) != 'string' || length(args.value) > 1024 ||
		type(args.expected) != 'string' || !length(args.expected) || length(args.expected) > 8192))
		return { ok: false, supported: true, changed: false, verified: false,
			error: 'Read current settings and confirm a valid change first' };
	let fd = popen(`/usr/libexec/vtmodem-radio ${shellquote(m.at_port)} ${shellquote(sprintf('%J', args))} 2>/dev/null`);
	if (!fd)
		return { ok: false, supported: true, changed: false, verified: false,
			error: 'Unable to start radio helper' };
	let out = fd.read(32769) ?? '';
	let rc = fd.close();
	try {
		if (rc === 0 && length(out) && length(out) <= 32768) {
			let result = json(out);
			if (type(result) == 'object' && type(result.ok) == 'bool')
				return result;
		}
	}
	catch (e) {}
	return { ok: false, supported: true, changed: changing, verified: false,
		error: 'Radio helper returned no valid result. Read the settings again before another change.' };
}


const methods = {
	status: { call: function() { return cached_status(); } },
	traffic_status: { call: function() { return traffic_status(); } },
	traffic_confirm_time: { args: { timestamp: 0 },
		call: function(request) { return traffic_confirm_time(request.args.timestamp); } },
	radio_status: { call: function() { return radio_call(detect_modem(), { action: 'status' }); } },
	radio_apply: { args: { action: '', value: '', expected: '', confirm: false },
		call: function(request) { return radio_call(detect_modem(), request.args); } },
	sms_list_start: { args: { request_id: '' },
		call: function(request) { return sms_start('list', request.args, detect_modem()); } },
	sms_send_start: { args: { phone: '', text: '', request_id: '' },
		call: function(request) { return sms_start('send', request.args, detect_modem()); } },
	sms_delete_start: { args: { messages: [], request_id: '' },
		call: function(request) { return sms_start('delete', request.args, detect_modem()); } },
	sms_job_status: { args: { job_id: '' },
		call: function(request) { return sms_job_status(request.args.job_id); } },
	// Legacy synchronous calls cannot safely retain their old blocking behavior.
	// The matching web package uses idempotent start + result polling above.
	sms_list: { call: function() { return { ok: false, supported: true, error_code: 'async_required', error: 'Reload the SMS page to use asynchronous operations' }; } },
	sms_send: { args: { phone: '', text: '' }, call: function() { return { ok: false, supported: true, error_code: 'async_required', error: 'Reload the SMS page to use asynchronous operations' }; } },
	sms_delete: { args: { id: 0 }, call: function() { return { ok: false, supported: true, error_code: 'async_required', error: 'Refresh the SMS list to obtain message fingerprints' }; } }
};
return { 'vtmodem': methods };
