'use strict';

import { access, basename, dirname, glob, popen, readfile } from 'fs';

function shellquote(s) {
	return `'${replace(s ?? '', "'", "'\\''")}'`;
}

function command(dev, cmd) {
	let fd = popen(`/usr/bin/vt-at ${shellquote(dev)} ${shellquote(cmd)} 2>/dev/null`);
	if (!fd)
		return '';

	let out = trim(fd.read('all') ?? '');
	fd.close();
	return out;
}

function value(dev, cmd, prefix) {
	let out = command(dev, cmd);
	if (!length(out))
		return '';

	let lines = split(out, '\n');
	for (let line in lines) {
		line = trim(line);
		if (!length(line) || line == 'ERROR')
			continue;
		if (prefix && index(line, prefix) == 0)
			return trim(substr(line, length(prefix)));
		if (!prefix)
			return line;
	}
	return '';
}

function lines(dev, cmd, prefix) {
	let out = command(dev, cmd);
	let result = [];

	for (let line in split(out, '\n')) {
		line = trim(line);
		if (!length(line) || line == 'ERROR')
			continue;
		if (!prefix || index(line, prefix) == 0)
			push(result, line);
	}

	return result;
}

function qmi_fields(value, names) {
	if (value == null)
		return null;
	if (type(value) != 'object')
		return false;

	let result = {};
	for (let name in names) {
		let v = value[name];
		if (v != null && type(v) != 'int' && type(v) != 'double')
			return false;
		result[name] = v ?? null;
	}
	return result;
}

function t99_qmi_status(device) {
	let unavailable = { qmi_signal: null, qmi_radio: null };
	if (device != '/dev/cdc-wdm0')
		return unavailable;

	// The standalone helper owns its timed children. Calling system() here
	// would let an unrelated rpcd child's SIGCHLD bypass its query timeout.
	let fd = popen('/usr/bin/ucode /usr/share/vtmodem/qmi-status.uc 2>/dev/null');
	if (!fd)
		return unavailable;

	let out = fd.read('all') ?? '';
	let rc = fd.close();
	if (rc != 0 || !length(out) || length(out) > 8192)
		return unavailable;

	try {
		let parsed = json(out);
		if (type(parsed) != 'object')
			return unavailable;
		let signal = qmi_fields(parsed.qmi_signal, [ 'rssi_dbm', 'rsrp_dbm', 'rsrq_db', 'snr_db' ]);
		let radio = qmi_fields(parsed.qmi_radio, [ 'band', 'earfcn', 'bandwidth_mhz' ]);
		if (signal === false || radio === false)
			return unavailable;
		return { qmi_signal: signal, qmi_radio: radio };
	}
	catch (e) {
		return unavailable;
	}
}

function find_usb(vid_expected, pid_expected) {
	for (let p in glob('/sys/bus/usb/devices/*/idVendor')) {
		let d = dirname(p);
		let vid = lc(trim(readfile(p) ?? ''));
		let pid = lc(trim(readfile(`${d}/idProduct`) ?? ''));

		if (vid == vid_expected && pid == pid_expected)
			return basename(d);
	}
	return '';
}

function find_l860_data_if() {
	for (let p in glob('/sys/class/net/*/address')) {
		if (lc(trim(readfile(p) ?? '')) == '00:00:11:12:13:14')
			return basename(dirname(p));
	}
	return access('/sys/class/net/wwan0') ? 'wwan0' : '';
}

function detect_modem() {
	let usb = find_usb('8087', '095a');
	if (length(usb) && access('/dev/ttyACM0')) {
		return {
			type: 'fibocom-l860',
			usb_id: '8087:095a',
			usb_device: usb,
			at_port: '/dev/ttyACM0',
			control_device: '',
			data_interface: find_l860_data_if()
		};
	}

	usb = find_usb('05c6', '9025');
	let t99_at = access('/dev/t99w175-at') ? '/dev/t99w175-at' : (access('/dev/ttyUSB2') ? '/dev/ttyUSB2' : '');
	if (length(usb) && length(t99_at)) {
		return {
			type: 't99w175',
			usb_id: '05c6:9025',
			usb_device: usb,
			at_port: t99_at,
			control_device: access('/dev/cdc-wdm0') ? '/dev/cdc-wdm0' : '',
			data_interface: access('/sys/class/net/wwan0') ? 'wwan0' : ''
		};
	}

	return null;
}

function common_status(m) {
	let dev = m.at_port;
	let data_mac = m.data_interface ? trim(readfile(`/sys/class/net/${m.data_interface}/address`) ?? '') : '';

	return {
		present: true,
		type: m.type,
		usb_id: m.usb_id,
		usb_device: m.usb_device,
		at_port: m.at_port,
		control_device: m.control_device,
		data_interface: m.data_interface,
		data_mac,
		sms_supported: m.type == 't99w175',
		manufacturer: value(dev, 'AT+CGMI'),
		model: value(dev, 'AT+CGMM'),
		firmware: value(dev, 'AT+CGMR'),
		imei: value(dev, 'AT+CGSN'),
		cfun: value(dev, 'AT+CFUN?', '+CFUN:'),
		sim_state: value(dev, 'AT+CPIN?', '+CPIN:'),
		iccid: value(dev, 'AT+CCID', '+CCID:'),
		imsi: value(dev, 'AT+CIMI'),
		operator: value(dev, 'AT+COPS?', '+COPS:'),
		registration: value(dev, 'AT+CEREG?', '+CEREG:'),
		registration_cs: value(dev, 'AT+CREG?', '+CREG:'),
		attached: value(dev, 'AT+CGATT?', '+CGATT:'),
		csq: value(dev, 'AT+CSQ', '+CSQ:'),
		cesq: m.type == 't99w175' ? '' : value(dev, 'AT+CESQ', '+CESQ:'),
		pdp_contexts: lines(dev, 'AT+CGDCONT?', '+CGDCONT:')
	};
}

function sms_call(m, args) {
	if (!m || m.type != 't99w175')
		return { ok: false, supported: false, error: 'SMS backend currently supports T99W175 only' };

	let cmd = `/usr/bin/vt-sms -d ${shellquote(m.at_port)} ${args} 2>/dev/null`;
	let fd = popen(cmd);
	if (!fd)
		return { ok: false, supported: true, error: 'Unable to start vt-sms' };

	let out = trim(fd.read('all') ?? '');
	fd.close();
	if (!length(out))
		return { ok: false, supported: true, error: 'No response from vt-sms' };

	let result = json(out);
	result.supported = true;
	return result;
}

const methods = {
	status: {
		call: function() {
			let m = detect_modem();
			if (!m) {
				return {
					present: false,
					type: '',
					usb_id: '',
					usb_device: '',
					at_port: '',
					control_device: '',
					data_interface: '',
					data_mac: '',
					sms_supported: false
				};
			}

			let s = common_status(m);

			if (m.type == 'fibocom-l860') {
				s.xcesq = value(m.at_port, 'AT+XCESQ?', '+XCESQ:');
				s.cell_measurement = value(m.at_port, 'AT+XMCI=1', '+XMCI:');
				s.ca_state = value(m.at_port, 'AT+XLEC?', '+XLEC:');
				s.temperature = value(m.at_port, 'AT+MTSM=1', '+MTSM:');
				s.data_channel = value(m.at_port, 'AT+XDATACHANNEL=2', '+XDATACHANNEL:');
				s.dns = lines(m.at_port, 'AT+XDNS?', '+XDNS:');
			}
			else {
				s.xcesq = '';
				s.cell_measurement = '';
				s.ca_state = '';
				s.temperature = '';
				s.data_channel = '';
				s.dns = [];
				let qmi = t99_qmi_status(m.control_device);
				s.qmi_signal = qmi.qmi_signal;
				s.qmi_radio = qmi.qmi_radio;
			}

			return s;
		}
	},

	sms_list: {
		call: function() {
			return sms_call(detect_modem(), 'list');
		}
	},

	sms_send: {
		args: {
			phone: '',
			text: ''
		},
		call: function(request) {
			let phone = request.args.phone ?? '';
			let text = request.args.text ?? '';
			if (!length(phone) || !length(text))
				return { ok: false, error: 'Phone number and SMS text are required' };
			if (length(text) > 16384)
				return { ok: false, error: 'SMS text is too large' };
			return sms_call(detect_modem(), `send ${shellquote(phone)} ${shellquote(text)}`);
		}
	},

	sms_delete: {
		args: {
			id: 0
		},
		call: function(request) {
			let id = request.args.id;
			if (id < 0 || id > 65535)
				return { ok: false, error: 'Invalid SMS id' };
			return sms_call(detect_modem(), `delete ${id}`);
		}
	}
};

return { 'vtmodem': methods };
