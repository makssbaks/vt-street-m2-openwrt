#!/bin/sh
# Bounded DW5821e USB -> netifd handoff. No AT/QMI queries, CFUN or USB reset.
TAG="dw5821e-net-ready"
LOCKFILE="/tmp/dw5821e-net-ready.lock"
log(){ logger -t "$TAG" "$*"; }
device_ready()
{
	local usb root qmi tty atpath
	usb="$(cat /tmp/dw5821e-hotplug.ready 2>/dev/null)"
	case "$usb" in ''|*[!0-9.-]*) return 1 ;; esac
	root="$(readlink -f "/sys/bus/usb/devices/$usb" 2>/dev/null)"; [ -n "$root" ] || return 1
	[ "$(cat "$root/idVendor" 2>/dev/null):$(cat "$root/idProduct" 2>/dev/null)" = "413c:81d7" ] || return 1
	[ "$(cat "$root/bConfigurationValue" 2>/dev/null)" = 1 ] || return 1
	[ -c /dev/cdc-wdm0 ] && [ -c /dev/dw5821e-at ] || return 1
	[ -e /sys/class/net/wwan0 ] || return 1
	qmi="$(readlink -f /sys/class/usbmisc/cdc-wdm0/device 2>/dev/null)"; case "$qmi" in "$root"/*) ;; *) return 1 ;; esac
	[ "$(readlink -f /sys/class/net/wwan0/device 2>/dev/null)" = "$qmi" ] || return 1
	tty="$(basename "$(readlink -f /dev/dw5821e-at 2>/dev/null)")"
	atpath="$(readlink -f "/sys/class/tty/$tty/device" 2>/dev/null)"; case "$atpath" in "$root"/*) ;; *) return 1 ;; esac
	return 0
}
main()
{
	local tries=0 status up pending available autostart proto configured
	exec 9>>"$LOCKFILE" || return 1; flock -n 9 || return 0
	while [ "$tries" -lt 60 ]; do
		tries=$((tries + 1)); device_ready || return 0
		configured="$(uci -q get network.modem.proto)"; [ "$configured" = t99w175qmi ] || return 0
		case "$(uci -q get network.modem.auto)" in 0|false|no|off) return 0 ;; esac
		case "$(uci -q get network.modem.disabled)" in 1|true|yes|on) return 0 ;; esac
		status="$(ubus -t 3 call network.interface.modem status 2>/dev/null)" || { sleep 2; continue; }
		proto="$(jsonfilter -s "$status" -e '@.proto' 2>/dev/null)"; [ "$proto" = t99w175qmi ] || return 0
		up="$(jsonfilter -s "$status" -e '@.up' 2>/dev/null)"
		pending="$(jsonfilter -s "$status" -e '@.pending' 2>/dev/null)"
		available="$(jsonfilter -s "$status" -e '@.available' 2>/dev/null)"
		autostart="$(jsonfilter -s "$status" -e '@.autostart' 2>/dev/null)"
		[ "$up" = true ] || [ "$pending" = true ] && return 0
		[ "$autostart" = false ] && return 0
		if [ "$up" != false ] || [ "$pending" != false ] || [ "$autostart" != true ]; then sleep 2; continue; fi
		case "$available" in
			false) if ubus -t 3 call network.interface notify_proto '{"interface":"modem","action":5,"available":true}' >/dev/null 2>&1; then log "USB ready; modem availability restored in netifd"; return 0; fi ;;
			true) return 0 ;;
		esac
		sleep 2
	done
	log "netifd handoff timed out; no interface restart or USB reset performed"; return 1
}
[ -n "$INCLUDE_ONLY" ] || main "$@"
