#!/bin/sh

TAG="vt-mac"

log()
{
	logger -t "$TAG" "$*"
}

factory_hex()
{
	local mtd
	mtd="$(awk -F: '$2 ~ /"Factory"/ {print "/dev/" $1; exit}' /proc/mtd 2>/dev/null)"
	[ -n "$mtd" ] || return 1
	dd if="$mtd" bs=1 skip=40 count=6 2>/dev/null | hexdump -v -e '1/1 "%02x"'
}

factory_valid()
{
	local h="$1" first
	[ "${#h}" -eq 12 ] || return 1
	case "$h" in *[!0-9a-fA-F]*) return 1;; esac
	h="$(printf '%s' "$h" | tr 'A-F' 'a-f')"
	[ "$h" != "000000000000" ] || return 1
	[ "$h" != "ffffffffffff" ] || return 1
	first=$((0x${h%??????????}))
	[ $((first & 1)) -eq 0 ]
}

find_t99_serial()
{
	local d
	for d in /sys/bus/usb/devices/*; do
		[ -f "$d/idVendor" ] || continue
		[ -f "$d/idProduct" ] || continue
		[ "$(cat "$d/idVendor" 2>/dev/null)" = "05c6" ] || continue
		[ "$(cat "$d/idProduct" 2>/dev/null)" = "9025" ] || continue
		cat "$d/serial" 2>/dev/null
		return 0
	done
	return 1
}

derive_mac()
{
	local serial="$1" hash tail
	if command -v sha256sum >/dev/null 2>&1; then
		hash="$(printf '%s' "$serial" | sha256sum | awk '{print $1}')"
	elif command -v md5sum >/dev/null 2>&1; then
		hash="$(printf '%s' "$serial" | md5sum | awk '{print $1}')"
	else
		return 1
	fi

	tail="$(printf '%s' "$hash" | cut -c1-10)"
	[ "${#tail}" -eq 10 ] || return 1
	printf '02:%s:%s:%s:%s:%s\n' \
		"$(printf '%s' "$tail" | cut -c1-2)" \
		"$(printf '%s' "$tail" | cut -c3-4)" \
		"$(printf '%s' "$tail" | cut -c5-6)" \
		"$(printf '%s' "$tail" | cut -c7-8)" \
		"$(printf '%s' "$tail" | cut -c9-10)"
}

mac_valid()
{
	local mac="$1"
	[ "${#mac}" -eq 17 ] || return 1
	printf '%s\n' "$mac" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' || return 1
	factory_valid "$(printf '%s' "$mac" | tr -d ':')"
}

bridge_section()
{
	local idx=0 name
	# @device indexing also enumerates named device sections.
	while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
		name="$(uci -q get "network.@device[$idx].name")"
		if [ "$name" = "br-lan" ]; then
			printf 'network.@device[%s]\n' "$idx"
			return 0
		fi
		idx=$((idx + 1))
	done
	return 1
}

set_bridge_mac()
{
	local mac="$1" section current
	mac_valid "$mac" || return 1
	section="$(bridge_section)"
	if [ -n "$section" ]; then
		current="$(uci -q get "$section.macaddr")"
		# Never overwrite a configured valid address, including a custom MAC.
		mac_valid "$current" || uci set "$section.macaddr=$mac" || return 1
	fi
	current="$(uci -q get network.lan.macaddr)"
	mac_valid "$current" || uci set "network.lan.macaddr=$mac" || return 1
	uci commit network
}

saved_mac()
{
	cat /etc/vt-street-m2.mac 2>/dev/null
}

save_mac()
{
	printf '%s\n' "$1" >/etc/vt-street-m2.mac || return 1
	chmod 0644 /etc/vt-street-m2.mac
}

main()
{
	local section current factory serial mac i
	section="$(bridge_section)"
	current=""
	[ -z "$section" ] || current="$(uci -q get "$section.macaddr")"
	if mac_valid "$current"; then
		log "configured LAN bridge MAC preserved"
		return 0
	fi
	current="$(uci -q get network.lan.macaddr)"
	if mac_valid "$current"; then
		# An invalid explicit bridge MAC would otherwise override this LAN MAC.
		set_bridge_mac "$current" || return 1
		log "configured LAN MAC preserved"
		return 0
	fi

	factory="$(factory_hex)"
	if factory_valid "$factory"; then
		log "valid Factory MAC present; fallback not needed"
		return 0
	fi

	mac="$(saved_mac)"
	if mac_valid "$mac"; then
		set_bridge_mac "$mac" || return 1
		log "restored saved LAN fallback MAC"
		return 0
	fi

	# Only first provision on a blank-Factory unit needs the USB serial.
	# Subsequent upgrades preserve UCI/the saved fallback even if the modem
	# has been replaced or is not ready during uci-defaults.
	serial=""
	i=0
	while [ "$i" -lt 15 ]; do
		serial="$(find_t99_serial)"
		[ -n "$serial" ] && break
		sleep 1
		i=$((i + 1))
	done
	if [ -z "$serial" ]; then
		log "blank Factory MAC and no T99 USB serial yet; leaving defaults script for retry"
		return 1
	fi
	mac="$(derive_mac "$serial")"
	if ! mac_valid "$mac"; then
		log "unable to derive deterministic MAC from T99 serial"
		return 1
	fi
	set_bridge_mac "$mac" || return 1
	save_mac "$mac" || return 1
	log "provisioned deterministic LAN MAC $mac from T99 USB serial"
}

main "$@"
