#!/bin/sh

TAG="t99w175-hotplug"
LOCKFILE="/tmp/t99w175-hotplug.lock"
READYFILE="/tmp/t99w175-hotplug.ready"

log()
{
	logger -t "$TAG" "$*"
}

remove_aliases()
{
	rm -f /dev/t99w175-at /dev/t99w175-diag /dev/t99w175-nmea
}

find_modem()
{
	for d in /sys/bus/usb/devices/*; do
		[ -f "$d/idVendor" ] || continue
		[ -f "$d/idProduct" ] || continue
		[ "$(cat "$d/idVendor" 2>/dev/null)" = "05c6" ] || continue
		[ "$(cat "$d/idProduct" 2>/dev/null)" = "9025" ] || continue
		readlink -f "$d"
		return 0
	done
	return 1
}

ensure_drivers()
{
	[ -d /sys/bus/usb/drivers/qmi_wwan ] || modprobe qmi_wwan 2>/dev/null
	[ -d /sys/bus/usb/drivers/option ] || modprobe option 2>/dev/null
	sleep 1
	[ -d /sys/bus/usb/drivers/option ]
}

ensure_dynamic_id()
{
	IDFILE="/sys/bus/usb-serial/drivers/option1/new_id"
	[ -w "$IDFILE" ] || {
		log "ERROR: option1/new_id unavailable"
		return 1
	}

	echo "05c6 9025" >"$IDFILE" 2>/dev/null || {
		[ -e /sys/class/tty/ttyUSB0 ] || return 1
	}
	return 0
}

unbind_adb()
{
	dev="$1"
	for i in "$dev"/"${dev##*/}":*; do
		[ -d "$i" ] || continue
		subclass="$(cat "$i/bInterfaceSubClass" 2>/dev/null)"
		proto="$(cat "$i/bInterfaceProtocol" 2>/dev/null)"
		[ "$subclass" = "42" ] || continue
		[ "$proto" = "01" ] || continue
		[ -L "$i/driver" ] || continue
		driver="$(basename "$(readlink -f "$i/driver" 2>/dev/null)")"
		[ "$driver" = "option" ] || continue
		iface="$(basename "$i")"
		if echo "$iface" >/sys/bus/usb/drivers/option/unbind 2>/dev/null; then
			log "ADB interface released: $iface"
		fi
	done
}

adb_is_bound()
{
	dev="$1"
	for i in "$dev"/"${dev##*/}":*; do
		[ -d "$i" ] || continue
		[ "$(cat "$i/bInterfaceSubClass" 2>/dev/null)" = "42" ] || continue
		[ "$(cat "$i/bInterfaceProtocol" 2>/dev/null)" = "01" ] || continue
		[ -L "$i/driver" ] && return 0
	done
	return 1
}

find_tty_by_protocol()
{
	wanted="$1"
	for t in /sys/class/tty/ttyUSB*; do
		[ -e "$t" ] || continue
		tty="$(basename "$t")"
		path="$(readlink -f "$t/device" 2>/dev/null)"
		[ -n "$path" ] || continue
		case "$path" in "$MODEM"/*) ;; *) continue ;; esac
		iface="$(dirname "$path")"
		[ "$(cat "$iface/bInterfaceProtocol" 2>/dev/null)" = "$wanted" ] || continue
		echo "/dev/$tty"
		return 0
	done
	return 1
}

make_aliases()
{
	DIAG="$(find_tty_by_protocol 30)"
	AT="$(find_tty_by_protocol 40)"
	NMEA="$(find_tty_by_protocol 60)"

	remove_aliases
	[ -n "$DIAG" ] && ln -s "$DIAG" /dev/t99w175-diag
	[ -n "$AT" ]   && ln -s "$AT"   /dev/t99w175-at
	[ -n "$NMEA" ] && ln -s "$NMEA" /dev/t99w175-nmea
	[ -n "$AT" ]
}

ready_state()
{
	dev="$1"
	AT="$(readlink -f /dev/t99w175-at 2>/dev/null)"
	[ -n "$AT" ] || return 1
	[ -c "$AT" ] || return 1
	[ -c /dev/cdc-wdm0 ] || return 1
	[ -e /sys/class/net/wwan0 ] || return 1
	local qmi
	qmi="$(readlink -f /sys/class/usbmisc/cdc-wdm0/device 2>/dev/null)"
	case "$qmi" in "$dev"/*) ;; *) return 1 ;; esac
	[ "$(readlink -f /sys/class/net/wwan0/device 2>/dev/null)" = "$qmi" ] || return 1

	T="$(basename "$AT")"
	P="$(readlink -f "/sys/class/tty/$T/device" 2>/dev/null)"
	[ -n "$P" ] || return 1
	case "$P" in "$dev"/*) ;; *) return 1 ;; esac
	I="$(dirname "$P")"
	[ "$(cat "$I/bInterfaceProtocol" 2>/dev/null)" = "40" ] || return 1
	adb_is_bound "$dev" && return 1
	return 0
}

find_firewall_zone()
{
	local section="$1" name networks
	config_get name "$section" name
	config_get networks "$section" network
	[ "$name" != wan ] || wan_section="$section"
	case " $networks " in *" modem "*) already_assigned=1 ;; esac
}

assign_initial_firewall_zone()
{
	local wan_section already_assigned=0
	. /lib/functions.sh
	config_load firewall
	config_foreach find_firewall_zone zone
	# config_foreach covers named and anonymous sections. Never add a second
	# zone if a pre-existing firewall configuration already assigns modem.
	[ "$already_assigned" = 0 ] && [ -n "$wan_section" ] || return 0
	uci -q add_list "firewall.$wan_section.network=modem" || return 1
	uci -q commit firewall || return 1
	firewall_changed=1
	log 'added new modem interface to firewall wan zone'
}

ensure_network_config()
{
	local network_changed=0 firewall_changed=0

	if ! uci -q get network.modem >/dev/null 2>&1; then
		uci -q set network.modem='interface'
		uci -q set network.modem.proto='t99w175qmi'
		uci -q set network.modem.auth='none'
		uci -q set network.modem.pdptype='ip'
		uci -q set network.modem.apn='internet'
		uci -q commit network
		network_changed=1
		log "created default network.modem (T99W175 QMI, APN internet, IPv4)"
		assign_initial_firewall_zone || log 'ERROR: initial firewall assignment failed'
	fi

	if [ "$network_changed" -eq 1 ]; then
		ubus -t 3 call network reload >/dev/null 2>&1 || true
	fi
	if [ "$firewall_changed" -eq 1 ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi

	# Run on every ready event, including unchanged configuration and
	# subsequent boots. The helper serializes itself and respects UP,
	# PENDING, auto=0 and a manual disconnect. It never invokes ifup.
	/usr/libexec/t99w175-net-ready 8>&- </dev/null >/dev/null 2>&1 &
}

modem_unavailable()
{
	rm -f "$READYFILE"
	remove_aliases
	[ "$(uci -q get network.modem.proto)" = t99w175qmi ] || return 0
	# Availability does not alter netifd's runtime autostart/manual Stop flag.
	ubus -t 3 call network.interface notify_proto \
		'{"interface":"modem","action":5,"available":false}' >/dev/null 2>&1 || true
}

main()
{
	# A kernel lock cannot be left stale after an interrupted hotplug script.
	umask 077
	exec 8>>"$LOCKFILE" || return 1
	flock -n 8 || return 0
	MODEM="$(find_modem)"
	if [ -z "$MODEM" ]; then
		modem_unavailable
		exit 0
	fi

	if [ -f "$READYFILE" ] && ready_state "$MODEM"; then
		ensure_network_config
		exit 0
	fi

	MODEM="$(find_modem)"
	[ -n "$MODEM" ] || {
		modem_unavailable
		exit 0
	}

	ensure_drivers || {
		log "ERROR: required USB drivers unavailable"
		exit 1
	}
	ensure_dynamic_id || {
		log "ERROR: failed to register 05c6:9025 with option"
		exit 1
	}

	stable=0
	n=0
	while [ "$n" -lt 15 ]; do
		MODEM="$(find_modem)"
		[ -n "$MODEM" ] || break
		unbind_adb "$MODEM"
		make_aliases >/dev/null 2>&1
		if ready_state "$MODEM"; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		[ "$stable" -ge 3 ] && break
		sleep 1
		n=$((n + 1))
	done

	make_aliases >/dev/null 2>&1
	if ready_state "$MODEM"; then
		echo "$(basename "$MODEM")" >"$READYFILE"
		log "ready: AT=$(readlink -f /dev/t99w175-at) DIAG=$(readlink -f /dev/t99w175-diag 2>/dev/null) NMEA=$(readlink -f /dev/t99w175-nmea 2>/dev/null) QMI=/dev/cdc-wdm0 IF=wwan0"
		ensure_network_config
		return 0
	fi

	rm -f "$READYFILE"
	modem_unavailable
	log "ERROR: T99W175 USB reconciliation incomplete"
	return 1
}

[ -n "$INCLUDE_ONLY" ] || { main; exit $?; }
