#!/bin/sh /etc/rc.common
# Reconcile already attached supported USB modems after network startup.
# No modem power cycle and no restart of an existing connection.
START=95

boot()
{
	(
		ACTION=add /etc/hotplug.d/usb/03_t99w175
		ACTION=add /etc/hotplug.d/usb/04_dw5821e
	) </dev/null >/dev/null 2>&1 &
}
