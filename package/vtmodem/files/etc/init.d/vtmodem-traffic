#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	umask 077
	mkdir -p /var/run/vtmodem-traffic /etc/vtmodem/traffic
	procd_open_instance vnstat
	procd_set_param command /usr/libexec/vtmodem-traffic-daemon
	procd_set_param file /etc/vtmodem/vnstat.conf
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_set_param respawn
	procd_close_instance
	procd_open_instance collector
	procd_set_param command /usr/bin/ucode /usr/share/vtmodem/traffic-collector.uc
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	rm -f /var/run/vtmodem-traffic/daemon-ready
}
