CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_vertell_vt-mt7621d=y

# Web UI for bring-up
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# Diagnostics
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_picocom=y

# Vendor-independent VT modem backend + LuCI status page
CONFIG_PACKAGE_vtmodem=y

# T99W175 / QMI
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_wwan is not set

# Fibocom L860-GL-16 / CDC ACM + CDC NCM
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

# MT7621 USB host
CONFIG_PACKAGE_kmod-usb3=y

# Bounded QMI helper processes require the BusyBox timeout applet.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TIMEOUT=y
